# Production Environment Configuration
# Copy to .env and fill in actual values

# === Database ===
DUCKDB_PATH=data/warehouse/market.duckdb

# === Logging ===
LOG_LEVEL=INFO

# === API Keys ===
# Groq API for AI features (get from https://console.groq.com)
GROQ_API_KEY=your_production_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# === Application Security ===
# Generate with: python -c "import os; print(os.urandom(32).hex())"
SECRET_KEY=your_secure_random_secret_key_here

# === Flask Configuration ===
FLASK_ENV=production
FLASK_DEBUG=0

# === Server Configuration ===
PORT=8000
HOST=0.0.0.0

# === Gunicorn Configuration (Linux/Mac) ===
GUNICORN_WORKERS=4
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=120
GUNICORN_BIND=0.0.0.0:8000

# === Waitress Configuration (Windows) ===
WAITRESS_THREADS=8
WAITRESS_CHANNEL_TIMEOUT=120

# === Performance ===
CACHE_DEFAULT_TIMEOUT=300
MAX_CONTENT_LENGTH=16777216

# === External Services ===
# News API (if using)
NEWS_API_KEY=

# Database connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# === Monitoring ===
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# === Feature Flags ===
ENABLE_AI_FEATURES=true
ENABLE_VECTOR_SEARCH=true
ENABLE_AUTO_EVENT_DETECTION=true

# === Rate Limiting ===
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=100

# === CORS (if needed) ===
CORS_ENABLED=false
CORS_ORIGINS=https://yourdomain.com

# === SSL/TLS (if terminating at application) ===
SSL_CERT_PATH=
SSL_KEY_PATH=
